{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "FIREBASE_SETUP.md",
      "README.md",
      "server.js",
      "package.json",
      "package-lock.json",
      "data/**",
      "node_modules/**",
      ".npm-cache/**",
      "work/**",
      "outputs/**",
      "esp32/**",
      ".arduino/**",
      ".vscode/**",
      ".firebase/**",
      ".git/**",
      ".firebaserc",
      ".gitignore",
      "firmware/**",
      "cloud-relay.js",
      "render.yaml",
      ".env",
      ".env.*",
      ".DS_Store"
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/auth.html"
      },
      {
        "source": "/register",
        "destination": "/auth.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
